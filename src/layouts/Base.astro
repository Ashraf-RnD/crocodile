---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title } = Astro.props as Props;
const pageTitle = title ? `${title} · Crocodile` : "Crocodile — AI Learning Tool";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="A self-paced AI engineering learning tool." />
  </head>
  <body>
    <slot />
  </body>
</html>
